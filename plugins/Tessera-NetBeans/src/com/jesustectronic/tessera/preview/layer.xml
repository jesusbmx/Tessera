<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE filesystem PUBLIC "-//NetBeans//DTD Filesystem 1.2//EN" "http://www.netbeans.org/dtds/filesystem-1_2.dtd">
<filesystem>
    <folder name="Actions">
        <folder name="Tools">
            <file name="com-jesustectronic-tessera-preview-PreviewAction.instance">
                <attr name="instanceCreate" newvalue="com.jesustectronic.tessera.preview.PreviewAction"/>
            </file>
        </folder>
    </folder>

    <!-- clic derecho en Projects y Files -->
    <folder name="Loaders">
        <folder name="text">
            <folder name="x-java">
                <folder name="Actions">
                    <file name="com-jesustectronic-tessera-preview-PreviewAction.shadow">
                        <attr name="originalFile" stringvalue="Actions/Tools/com-jesustectronic-tessera-preview-PreviewAction.instance"/>
                        <attr name="position" intvalue="1150"/>
                    </file>
                </folder>
            </folder>
        </folder>
    </folder>

    <!-- el editor: su pestana y el clic derecho dentro de el -->
    <folder name="Editors">
        <folder name="text">
            <folder name="x-java">
                <!-- pestana "Tessera Preview" del editor, entre Source (2000) e History (1000000) -->
                <folder name="MultiView">
                    <file name="com-jesustectronic-tessera-preview-PreviewElement.instance">
                        <attr name="instanceCreate" methodvalue="org.netbeans.core.spi.multiview.MultiViewFactory.createMultiViewDescription"/>
                        <attr name="instanceClass" stringvalue="org.netbeans.core.multiview.ContextAwareDescription"/>
                        <attr name="class" stringvalue="com.jesustectronic.tessera.preview.PreviewElement"/>
                        <attr name="displayName" bundlevalue="com.jesustectronic.tessera.preview.Bundle#CTL_PreviewTab"/>
                        <attr name="preferredID" stringvalue="tessera.preview"/>
                        <attr name="persistenceType" intvalue="2"/>
                        <attr name="position" intvalue="2500"/>
                    </file>
                </folder>
                <folder name="Popup">
                    <file name="com-jesustectronic-tessera-preview-PreviewAction.shadow">
                        <attr name="originalFile" stringvalue="Actions/Tools/com-jesustectronic-tessera-preview-PreviewAction.instance"/>
                        <attr name="position" intvalue="1150"/>
                    </file>
                </folder>
            </folder>
        </folder>
    </folder>
</filesystem>
